# Property-based tests for the standard trie — DIRECT-CODE FORM.
#
# This file exercises boru:test's imperative property surface: the
# `Test.check-prop` driver, called directly with explicit run / seed /
# shrink counts —
#
#   Test.check-prop NAME [GEN-BODY] [PROP-BODY] RUNS SEED MAX-SHRINKS
#
# The sibling file `test/trie_prop_spec.aql` covers the same ideas through
# the declarative `PropertySpec` surface. Keeping both exercises both halves
# of the framework; this form takes RUNS explicitly, so the heavier
# whole-trie properties (keys round-trip, longest-prefix) run at a smaller
# budget.
#
# Each `Test.check-prop` returns its result Map; binding it (`def _pN (…)`)
# keeps the six maps from lingering on the stack and being dumped after
# "all green" at the end of the run.
#
# Run:
#   boru test/trie_prop_test.aql


import "boru:test"
import "boru:string-util"
import "../trie.aql"


def charset "abcdefghijklmnopqrstuvwxyz"


# Distinct elements of `xs` (replaces boru:array's array.unique): rebuild a
# TrieSet from the keys and read its keys back — unique (and sorted).
def uniq fn [ [xs:List] [List] [ (xs TrieSet.from-keys) TrieSet.keys ] ]


# Build a TrieMap binding each generated key to itself.
def map-of fn [
  [ks:List] [Map] [
    (TrieMap.make) ks [
      var [[k acc] acc k k TrieMap.set end ]
    ] fold
  ]
]

# Element-wise list equality (boru's `eq` on lists is identity, not deep).
# Call: `a b list-eq`.
def list-eq fn [
  [a:List b:List] [Boolean] [
    if (((a size) (b size) eq) not) [false] [
      true (iota (a size)) [
        var [[i acc] acc ((a get (i)) (b get (i)) eq) and ]
      ] fold
    ]
  ]
]


# --- P1. add then has -----------------------------------------------

def _p1 (Test.check-prop "no-false-negatives"
  [r.string charset 8]
  [
    var [[s]
      def t ((TrieSet.make) s TrieSet.add)
      t s TrieSet.has end
    ]
  ]
  20 1 0)


# --- P2. set/get round-trips the value ------------------------------

def _p2 (Test.check-prop "set-get-roundtrip"
  [r.string charset 8]
  [
    var [[s]
      def t ((TrieMap.make) s 42 TrieMap.set)
      (t s TrieMap.get) 42 eq
    ]
  ]
  20 1 0)


# --- P3. keys() is sorted, distinct, and equals size ----------------

def _p3 (Test.check-prop "keys-sorted-and-counted"
  [r.list-of [r.string charset 5] 12]
  [
    var [[ks]
      def t (ks map-of)
      def ks (t TrieMap.keys)
      def s1 ((ks sort) ks list-eq)
      def s2 ((ks size) (t TrieMap.size) eq)
      def s3 ((ks uniq size) (ks size) eq)
      s1 s2 and s3 and
    ]
  ]
  20 1 0)


# --- P4. longest-prefix returns a stored key that prefixes the query -

def _p4 (Test.check-prop "longest-prefix-valid"
  [r.string charset 10]
  [
    var [[s]
      # store three nested prefixes of s
      def k1 (s slice 0 2)
      def k2 (s slice 0 5)
      def t (((TrieSet.make) k1 TrieSet.add) k2 TrieSet.add)
      def lp (t s TrieSet.longest-prefix)
      # the longest stored prefix of a 10-char s is k2 (5 chars)
      lp k2 eq
    ]
  ]
  20 1 0)


# --- P5. delete removes exactly the target --------------------------

def _p5 (Test.check-prop "delete-target-only"
  [r.list-of [r.string charset 5] 10]
  [
    var [[ks]
      def t (ks map-of)
      def k (ks get 0)
      def t2 (t k TrieMap.delete)
      def gone ((t2 k TrieMap.has) not)
      # any other distinct key is still present
      def others (ks uniq)
      def survived (others each [
        var [[o] if (o k eq) [true] [t2 o TrieMap.has end] ]
      ])
      def allsurv (survived all)
      gone allsurv and
    ]
  ]
  20 1 0)


# --- P6. encode mentions the key count ------------------------------

def _p6 (Test.check-prop "encode-has-size"
  [r.list-of [r.string charset 5] 8]
  [
    var [[ks]
      def t (ks map-of)
      def enc (t TrieMap.encode)
      def n (t TrieMap.size)
      enc `"size": ${n}` StringUtil.contains
    ]
  ]
  10 1 0)


# --- summary -------------------------------------------------------

"---" print end
"results:" print end
def all-results (Test.results end)
def _print-results (0 all-results [
  var [[r acc]
    def nm (r "name" get)
    def ok (r "ok" get)
    if ok [ `  pass: ${nm}` print ] [ `  FAIL: ${nm}  failing-input=${r "failing-input" get}` print ]
    acc
  ]
] fold)
"fail count: " print end
(Test.fail-count) print end
Assert.equal 0 (Test.fail-count) end
"all green" print end
